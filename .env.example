# divy.dev — copy to .env (git-ignored). Every value below is a safe local default.
# The Go binary never reads this file; `make dev`, docker compose and Vercel export the variables.

# ---- serve ----
# Vercel sets PORT; it wins over DIVY_ADDR.
PORT=
DIVY_ADDR=:8080
# Time-series database. file: = SQLite on disk (modernc, WAL); libsql:// or https:// = Turso.
DIVY_DB_URL=file:./data/divy.db
# Injected by the Vercel Turso integration; when set they win over DIVY_DB_URL
# (TURSO_AUTH_TOKEN is appended as ?authToken=).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DIVY_CONTENT_DIR=./content
# Absolute origin of the site as visitors see it (robots.txt, og_image, curl hints).
# Local: the Vite dev server proxies to the API. Production: https://<project>.vercel.app
SITE_ORIGIN=http://localhost:5173
DIVY_LOG_LEVEL=info
DIVY_LOG_FORMAT=text
OTEL_SERVICE_NAME=divy-api

# ---- collect endpoint (Vercel has no in-process scheduler) ----
# Bearer token expected by GET|POST /api/collect; the GitHub Actions schedule sends it.
DIVY_COLLECT_TOKEN=
# Vercel Cron sends its own secret as the bearer token; accepted as an alternative.
CRON_SECRET=
# Wall-clock budget of one collection round (must stay well under the function limit).
DIVY_COLLECT_BUDGET=8s

# ---- collectors ----
# The ONLY GitHub token variable the app reads. Classic PAT with `repo` + `read:user` to count
# private-org PRs/commits, or `public_repo` + `read:user` (or a fine-grained PAT) for public
# data only. Empty = GitHub collector disabled (reported as skipped, nothing faked).
DIVY_GITHUB_TOKEN=
DIVY_GITHUB_LOGIN=divysinghvi
# Owners whose repositories are counted but never named.
DIVY_GITHUB_PRIVATE_ORGS=gradr
PYPI_PACKAGES=codemind-ci
# Self-probe target; default = $SITE_ORIGIN/readyz. Probed from the same process:
# a full outage shows as a gap, not red.
UPTIME_SELF_URL=
PROBE_TIMEOUT=10s
# Cadences for local `serve --collect` / `divy collect` (the collect endpoint ignores them).
COLLECT_GITHUB_INTERVAL=15m
COLLECT_PYPI_INTERVAL=60m
COLLECT_UPTIME_INTERVAL=5m
COLLECT_MANUAL_INTERVAL=15m
COLLECT_RETENTION_INTERVAL=60m
# Comma list of collectors to disable (github, pypi, uptime, manual, retention).
COLLECT_DISABLED=

# ---- server extras ----
# Exact origins allowed by CORS (Grafana in server access mode needs none); empty = no CORS headers.
CORS_ORIGINS=http://localhost:5173
# CIDRs allowed to set X-Forwarded-For / X-Real-IP; empty = trust nobody.
TRUSTED_PROXIES=
# Believe the forwarding headers from any peer (on|off). Default: on when VERCEL is set
# (the platform terminates TLS and sets them), off elsewhere.
TRUST_PROXY_HEADERS=
# OpenTelemetry self-tracing: spans go to the otel_spans table and every response carries
# X-Divy-Trace-Id (+ X-Divy-Trace-Sampled). off disables both. Kept 24 h / last 20k spans.
OTEL_TRACING=on
# Root spans recorded per second and burst (traces, not spans); Prometheus scrapes of
# /metrics are never recorded.
OTEL_SAMPLE_RPS=100
OTEL_SAMPLE_BURST=200
# Per-client token bucket (per instance on Vercel; the platform's DDoS protection is the outer
# layer). off or 0 disables. /_app/* and /fonts/* are never limited.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=100
# One bucket shared by every client for /healthz, /readyz and /metrics.
RATE_LIMIT_GLOBAL_RPS=50
RATE_LIMIT_GLOBAL_BURST=200
# In-memory response cache for the API families (X-Cache: HIT|MISS, weak ETag, 304). off disables.
RESPONSE_CACHE=on
# PromQL default lookback (stored counters are one sample per UTC day); the request
# parameter lookback_delta overrides it per query.
QUERY_LOOKBACK_DELTA=26h
# PromQL guards: wall time per query (the request's timeout= can only narrow it),
# samples loaded per query, concurrent evaluations.
QUERY_TIMEOUT=30s
QUERY_MAX_SAMPLES=2000000
QUERY_MAX_CONCURRENCY=20

# ---- web (SvelteKit reads only API_* and PUBLIC_* from this file) ----
# Where +page.server.ts loads fetch during `vite dev` and prerender.
API_BASE=http://127.0.0.1:8080
# Absolute origin baked into canonical/og tags at build time (same as SITE_ORIGIN).
PUBLIC_SITE_ORIGIN=http://localhost:5173
