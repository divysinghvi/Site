{
	"name": "divy-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
		"build": "vite build && node scripts/postbuild.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"gen:types": "node scripts/gen-types.mjs",
		"e2e": "playwright test",
		"shots": "node scripts/screenshots.mjs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0"
	},
	"devDependencies": {
		"@playwright/test": "1.56.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "22.20.1",
		"json-schema-to-typescript": "16.0.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.2.2"
	}
}
