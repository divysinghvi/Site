{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divy.dev/schema/postmortem.schema.json",
  "$ref": "#/$defs/PostmortemFrontmatter",
  "$defs": {
    "DateOrTodo": {
      "type": "string",
      "pattern": "^(\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?|TODO\\(divy\\)(: .+)?)$"
    },
    "PostmortemFrontmatter": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^INC-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "maxLength": 90,
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "date": {
          "$ref": "#/$defs/DateOrTodo"
        },
        "span": {
          "type": "string"
        },
        "services": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "duration": {
          "type": "string",
          "pattern": "^(([0-9]+)(ms|s|m|h|d|w|y))+$|^TODO\\(divy\\)(: .+)?$"
        },
        "status": {
          "$ref": "#/$defs/PostmortemStatus"
        },
        "tags": {
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "type": "array"
        },
        "summary": {
          "type": "string",
          "maxLength": 160,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "severity",
        "date",
        "span",
        "services",
        "duration",
        "status",
        "summary"
      ]
    },
    "PostmortemStatus": {
      "type": "string",
      "enum": [
        "resolved",
        "monitoring",
        "open"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "SEV1",
        "SEV2",
        "SEV3",
        "SEV4"
      ]
    }
  }
}
