{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divy.dev/schema/spans.schema.json",
  "$ref": "#/$defs/SpansFile",
  "$defs": {
    "DateOrTodo": {
      "type": "string",
      "pattern": "^(\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?|TODO\\(divy\\)(: .+)?)$"
    },
    "Event": {
      "properties": {
        "ts": {
          "$ref": "#/$defs/DateOrTodo"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "ts",
        "name"
      ]
    },
    "Link": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "postmortem"
              }
            }
          },
          "then": {
            "required": [
              "ref"
            ]
          },
          "else": {
            "required": [
              "url"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "ref": {
          "type": "string",
          "pattern": "^INC-[0-9]{3}$"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri"
            },
            {
              "pattern": "^TODO\\(divy\\)"
            }
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "LinkKind": {
      "type": "string",
      "enum": [
        "postmortem",
        "repo",
        "pr",
        "pypi",
        "url"
      ]
    },
    "Scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "Service": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "counts_as_experience": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "title",
        "color"
      ]
    },
    "Span": {
      "if": {
        "properties": {
          "open": {
            "const": true
          }
        },
        "required": [
          "open"
        ]
      },
      "then": true,
      "else": {
        "required": [
          "end"
        ]
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
        },
        "service": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/DateOrTodo"
        },
        "end": {
          "$ref": "#/$defs/DateOrTodo"
        },
        "open": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/SpanStatus"
        },
        "tags": {
          "additionalProperties": {
            "$ref": "#/$defs/TagValue"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "type": "object"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "type": "array"
        },
        "todo": {
          "items": {
            "type": "string",
            "pattern": "^TODO\\(divy\\)"
          },
          "type": "array"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "service",
        "start"
      ]
    },
    "SpanStatus": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    },
    "SpansFile": {
      "properties": {
        "version": {
          "type": "integer",
          "maximum": 1,
          "minimum": 1
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": "array",
          "minItems": 1
        },
        "trace": {
          "$ref": "#/$defs/Span"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "services",
        "trace"
      ]
    },
    "TagValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    }
  }
}
