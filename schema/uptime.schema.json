{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divy.dev/schema/uptime.schema.json",
  "$ref": "#/$defs/UptimeFile",
  "$defs": {
    "IntOrList": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "ProbeMethod": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD"
      ]
    },
    "UptimeFile": {
      "properties": {
        "targets": {
          "items": {
            "$ref": "#/$defs/UptimeTarget"
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "targets"
      ]
    },
    "UptimeTarget": {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https?://",
              "format": "uri"
            },
            {
              "pattern": "^TODO\\(divy\\)"
            }
          ],
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/ProbeMethod"
        },
        "expected_status": {
          "$ref": "#/$defs/IntOrList"
        },
        "timeout": {
          "type": "string",
          "pattern": "^(([0-9]+)(ms|s|m|h|d|w|y))+$"
        },
        "interval": {
          "type": "string",
          "pattern": "^(([0-9]+)(ms|s|m|h|d|w|y))+$"
        },
        "follow_redirects": {
          "type": "boolean"
        },
        "span": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "url"
      ]
    }
  }
}
