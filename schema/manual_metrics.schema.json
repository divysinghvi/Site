{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divy.dev/schema/manual_metrics.schema.json",
  "$ref": "#/$defs/ManualMetricsFile",
  "$defs": {
    "DateOrTodo": {
      "type": "string",
      "pattern": "^(\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?|TODO\\(divy\\)(: .+)?)$"
    },
    "ManualMetric": {
      "properties": {
        "metric": {
          "type": "string",
          "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "value": {
          "type": "number"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "$ref": "#/$defs/DateOrTodo"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "metric",
        "value",
        "source",
        "updated_at"
      ]
    },
    "ManualMetricsFile": {
      "properties": {
        "metrics": {
          "items": {
            "$ref": "#/$defs/ManualMetric"
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "metrics"
      ]
    }
  }
}
