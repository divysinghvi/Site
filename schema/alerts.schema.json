{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divy.dev/schema/alerts.schema.json",
  "$ref": "#/$defs/AlertsFile",
  "$defs": {
    "AlertGroup": {
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "pattern": "^(([0-9]+)(ms|s|m|h|d|w|y))+$"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/AlertRule"
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "rules"
      ]
    },
    "AlertRule": {
      "properties": {
        "alert": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "for": {
          "type": "string",
          "pattern": "^(([0-9]+)(ms|s|m|h|d|w|y))+$"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "alert",
        "expr"
      ]
    },
    "AlertsFile": {
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/AlertGroup"
          },
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "groups"
      ]
    }
  }
}
